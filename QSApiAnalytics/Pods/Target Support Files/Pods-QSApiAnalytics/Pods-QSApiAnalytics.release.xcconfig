ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire-iOS" "${PODS_CONFIGURATION_BUILD_DIR}/OptimizedSQLCipher" "${PODS_CONFIGURATION_BUILD_DIR}/QSIpLocation-iOS" "${PODS_CONFIGURATION_BUILD_DIR}/QSJsonParser-iOS" "${PODS_CONFIGURATION_BUILD_DIR}/QSModelConvert-iOS" "${PODS_CONFIGURATION_BUILD_DIR}/QSNetRequest-iOS" "${PODS_CONFIGURATION_BUILD_DIR}/SQLiteRepair" "${PODS_CONFIGURATION_BUILD_DIR}/WCDBSwift"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire-iOS/Alamofire.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/OptimizedSQLCipher/sqlcipher.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/QSIpLocation-iOS/QSIpLocation.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/QSJsonParser-iOS/QSJsonParser.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/QSModelConvert-iOS/QSModelConvert.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/QSNetRequest-iOS/QSNetRequest.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SQLiteRepair/sqliterk.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/WCDBSwift/WCDBSwift.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -l"c++" -l"z" -framework "Alamofire" -framework "CFNetwork" -framework "Foundation" -framework "QSIpLocation" -framework "QSJsonParser" -framework "QSModelConvert" -framework "QSNetRequest" -framework "Security" -framework "WCDBSwift" -framework "sqlcipher" -framework "sqliterk"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Alamofire-iOS" "-F${PODS_CONFIGURATION_BUILD_DIR}/OptimizedSQLCipher" "-F${PODS_CONFIGURATION_BUILD_DIR}/QSIpLocation-iOS" "-F${PODS_CONFIGURATION_BUILD_DIR}/QSJsonParser-iOS" "-F${PODS_CONFIGURATION_BUILD_DIR}/QSModelConvert-iOS" "-F${PODS_CONFIGURATION_BUILD_DIR}/QSNetRequest-iOS" "-F${PODS_CONFIGURATION_BUILD_DIR}/SQLiteRepair" "-F${PODS_CONFIGURATION_BUILD_DIR}/WCDBSwift"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
